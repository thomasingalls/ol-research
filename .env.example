# Copy to .env in the repository root. `just` loads it automatically.
# Keep the real key here only in .env, never in web/.env or a VITE_ variable.
OL_RHT_CHAT_PROVIDER=openrouter
OL_RHT_CHAT_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_API_KEY=

# To use the cached model instead: set OL_RHT_CHAT_PROVIDER=local and
# OL_RHT_CHAT_MODEL=local-gemma, then run `just chat-model` as well.
